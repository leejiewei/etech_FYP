# ---------------------------------------------------------------
# AI / editor tooling
#
# These are the assistant's working files, not the project. They are
# ignored rather than deleted: they still work on this machine, they
# just do not belong in the repository or in a submission.
# ---------------------------------------------------------------
.claude/
.agents/
.serena/
.mcp.json
CLAUDE.md
skills-lock.json
graphify-out/
.playwright/
.playwright-cli/

# Android Studio writes its AI assistant's plan files here.
mobile/android/.artifacts/

# ---------------------------------------------------------------
# Build output and caches
#
# mobile/build alone is 843 MB, and every byte of it is regenerated by
# `flutter build`. Committing it would make the repository unusable.
# ---------------------------------------------------------------
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/app/build/
mobile/*.iml
.dart_tool/

# Supabase CLI scratch
supabase/.temp/

# ---------------------------------------------------------------
# Secrets
#
# Nothing of the sort is in the project today -- the Gemini key lives
# as a Supabase Edge Function secret and the Supabase publishable key
# is meant to be public. These rules are here so that stays true.
# ---------------------------------------------------------------
.env
.env.*
*.key
*.pem
service-role*

# ---------------------------------------------------------------
# Operating system junk
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# Python bytecode from tools/
__pycache__/
*.pyc

# Python environment for the ml/ notebooks (recreate: python -m venv ml/.venv, then pip install -r ml/requirements.txt)
ml/.venv/
.ipynb_checkpoints/

# raw product photos the user downloads; processed copies go to web/images/products
photo-inbox/
